<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Secretos locales (SMTP) fuera del repositorio: dotnet user-secrets set "Email:SmtpPass" "..." -->
    <UserSecretsId>mrehunter-api-local</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Las imágenes subidas viven en el servidor: el publish/deploy no debe sobrescribirlas. -->
    <Content Update="wwwroot\uploads\**" CopyToPublishDirectory="Never" />
    <!-- Hojas de vida de postulantes: datos personales, nunca se publican ni se versionan. -->
    <Content Remove="uploads\**" />
    <None Remove="uploads\**" />
    <!-- Carpetas de trabajo que nunca deben llegar al servidor ni compilarse:
         publicaciones anteriores (con appsettings viejos), salidas sueltas, pruebas y copias de la BD. -->
    <Content Remove="publish\**;Debug\**;postman\**;db-dumps\**" />
    <None Remove="publish\**;Debug\**;postman\**;db-dumps\**" />
    <Compile Remove="publish\**;Debug\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="MailKit" Version="4.18.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.OpenApi" Version="1.6.14" />
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.2" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
    <PackageReference Include="Swashbuckle.AspNetCore.Annotations" Version="6.5.0" />
    <PackageReference Include="Swashbuckle.AspNetCore.Filters" Version="8.0.2" />
  </ItemGroup>

</Project>
